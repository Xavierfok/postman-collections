{
  "info": {
    "_postman_id": "983e5a1a-1667-50bd-841f-7411e6d0f9a9",
    "name": "Singapore Mobile Proxy - Customer API",
    "description": "Customer API for [Singapore Mobile Proxy](https://singaporemobileproxy.com/?utm_source=postman&utm_medium=collection): dedicated 4G/5G proxies on real Singapore SIMs (Singtel or M1).\n\n**Auth:** create a key in the [client dashboard](https://singaporemobileproxy.com/client?utm_source=postman&utm_medium=collection), then set `apiKey` in the environment. It goes in the `x-api-key` header (set at collection level).\n\n**Base URL:** `https://singaporemobileproxy.com/api/v1`. POST bodies can be JSON or form-encoded.\n\n**Errors** are JSON: `{\"detail\": {\"message\": \"...\"}}`. 400 bad parameter, 401 bad key, 402 payment needed, 403 reseller key (use the reseller collection), 404 not found, 429 rate limited (60 requests a minute, 5 purchases an hour, 5 minutes between rotations or reboots of a proxy).\n\n**Reseller accounts** use the separate *Singapore Mobile Proxy - Reseller API* collection; reseller keys are refused here.\n\nHuman docs: https://singaporemobileproxy.com/api-docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is JSON', function () {",
          "    pm.response.to.have.jsonBody();",
          "});"
        ]
      }
    }
  ],
