          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proxy/change-ip?license={{licenseUuid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "proxy",
                "change-ip"
              ],
              "query": [
                {
                  "key": "license",
                  "value": "{{licenseUuid}}",
